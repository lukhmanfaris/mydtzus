# ─────────────────────────────────────────────────────────────────────────────
# Phase 1 — clickable prototype on mock data.
# Runs with DATA_SOURCE=mock and NO Supabase credentials present (spec §14).
# Verified: the app boots and serves the full flow with the two Supabase
# variables unset. If a hosting panel insists on values, use placeholders —
# do NOT paste the real service role key into a build environment.
# ─────────────────────────────────────────────────────────────────────────────

DATA_SOURCE=mock

# Claim deadline. Leave blank to hide the countdown timer entirely.
# OPEN ITEM 3 — if there is no deadline, strip the timer rather than
# leaving a dead component.
CAMPAIGN_END_ISO=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED IN EVERY ENVIRONMENT, including Phase 1.
#
# The app refuses to start without this. It previously fell back to a hardcoded
# literal, which meant anyone with the source could forge a verification cookie
# and claim a voucher without an access code.
#
# Generate:  openssl rand -base64 48
# Minimum 32 characters. Never commit the real value. Rotate it if it leaks —
# rotating invalidates all live sessions, which is the intended effect.
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Client IP resolution for rate limiting.
#
# Names the ONE header your proxy sets. Anything not named here is ignored,
# because `x-forwarded-for` is attacker-controlled and rotating it previously
# gave unlimited access-code guesses.
#
#   cf-connecting-ip        on Cloudflare
#   x-vercel-forwarded-for  on Vercel
#   x-forwarded-for         behind your own trusted reverse proxy ONLY
#
# Leave BLANK for direct-to-Node deployments — the socket address is used.
# Setting this wrong is worse than leaving it unset.
# ─────────────────────────────────────────────────────────────────────────────
TRUSTED_CLIENT_IP_HEADER=

# Ceiling on FAILED verifies across all clients per 10-minute window.
# Backstop against an attacker rotating real source IPs. Only failures count,
# so genuine recipients never reach it. Raise it as the recipient list grows.
GLOBAL_VERIFY_FAILURE_LIMIT=200
# DISABLE_GLOBAL_VERIFY_CEILING=true

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2 — Supabase. Set DATA_SOURCE=supabase to switch. No UI changes.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS on every table. Server-side only.
# Never prefix it with NEXT_PUBLIC_, never expose it to a build tool that
# inlines variables into the client bundle.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
