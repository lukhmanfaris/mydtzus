{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mydtzus",
  // mydatamarcomm@gmail.com's Cloudflare account. Not secret; used by CI deploys.
  "account_id": "64ea7e0ef3557ce651b0576da6866bf7",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // The React app. Unknown paths fall back to index.html; only /api/* runs the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Per-IP limit on POST /api/submit. Counters are per Cloudflare location, not
  // global — treat it as abuse dampening, not exact accounting. Period must be 10 or 60.
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "observability": { "enabled": true },

  // Daily keep-alive for the free Supabase project, 01:00 UTC = 09:00 MYT.
  "triggers": { "crons": ["0 1 * * *"] },

  // Non-secret settings. Secrets go in with `wrangler secret put`:
  //   SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET_KEY
  // Local overrides live in .dev.vars (see .dev.vars.example).
  "vars": {
    "DATA_SOURCE": "supabase",
    "SUPABASE_URL": "https://pkvbdhzhroncqnaznqgo.supabase.co",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFLQFwx61r47xd8E",
    // e.g. "2026-12-31T23:59:59+08:00". Blank = no closing date.
    "CAMPAIGN_END_ISO": "2026-11-10T23:59:59+08:00"
  }
}
